{
  "name": "@nettrek/c2pa-hls-bridge",
  "version": "0.4.0",
  "description": "",
  "main": "src/index.ts",
  "author": "Florian Diesner",
  "license": "MIT",
  "keywords": [
    "c2pa",
    "hls.js",
    "video",
    "streaming"
  ],
  "homepage": "https://www.nettrek.de",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chunked": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chunked.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.js",
      "import": "./dist/helpers.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "node esbuild.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "preview": "npx http-server dist -c-1 --port 5173",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "hls.js": "^1.6.7"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "^0.12.0",
    "@flatten-js/interval-tree": "^1.1.3",
    "@nettrek/c2pa-web-crypto": "^0.1.0"
  },
  "devDependencies": {
    "@contentauth/c2pa-types": "^0.7.0",
    "esbuild": "^0.25.11",
    "hls.js": "1.6.7",
    "typescript": "^5.9.3"
  }
}
